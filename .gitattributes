# 自动检测文本文件并在检出时转换为系统格式
* text=auto

# 确保这些文件始终使用 LF 换行符
*.cs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf

