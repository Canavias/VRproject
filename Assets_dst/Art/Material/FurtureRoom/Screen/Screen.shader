		_ScreenAlpha("ScreenAlpha", 2D) = "white" {}
		_AlphaIntensity("AlphaIntensity", Range( 0 , 1)) = 0
		[HideInInspector] _texcoord( "", 2D ) = "white" {}
		[HideInInspector] __dirty( "", Int ) = 1
	}

	SubShader
	{
		Tags{ "RenderType" = "Transparent"  "Queue" = "Transparent+0" "IgnoreProjector" = "True" "IsEmissive" = "true"  }
		Cull Off
		CGINCLUDE
		#include "UnityPBSLighting.cginc"
		#include "Lighting.cginc"
		#pragma target 3.0
		struct Input
		{
			float2 uv_texcoord;
		};

		uniform sampler2D _EmissionTex;
		uniform float4 _EmissionTex_ST;
		uniform float _EmisiionIntensity;
		uniform sampler2D _ScreenAlpha;
		SamplerState sampler_ScreenAlpha;
		uniform float4 _ScreenAlpha_ST;
		uniform float _AlphaIntensity;

		inline half4 LightingUnlit( SurfaceOutput s, half3 lightDir, half atten )
		{
			return half4 ( 0, 0, 0, s.Alpha );
		}

		void surf( Input i , inout SurfaceOutput o )
		{
			float2 uv_EmissionTex = i.uv_texcoord * _EmissionTex_ST.xy + _EmissionTex_ST.zw;
			o.Emission = ( tex2D( _EmissionTex, uv_EmissionTex ) * _EmisiionIntensity ).rgb;
			float2 uv_ScreenAlpha = i.uv_texcoord * _ScreenAlpha_ST.xy + _ScreenAlpha_ST.zw;
			float clampResult7 = clamp( ( tex2D( _ScreenAlpha, uv_ScreenAlpha ).r + _AlphaIntensity ) , 0.0 , 1.0 );
			o.Alpha = clampResult7;
		}

		ENDCG
		CGPROGRAM
		#pragma surface surf Unlit alpha:fade keepalpha fullforwardshadows 

		ENDCG
		Pass
