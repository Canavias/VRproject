			float simplePerlin2D10 = snoise( i.uv_texcoord*_NoiseScale );
			simplePerlin2D10 = simplePerlin2D10*0.5 + 0.5;
			float smoothstepResult7 = smoothstep( _SmoothMin , _SmoothMax , simplePerlin2D10);
			float clampResult6 = clamp( ( smoothstepResult7 + _BaseSmoothness ) , 0.0 , 1.0 );
			o.Emission = ( _BaseColor * clampResult6 ).rgb;
			o.Alpha = 1;
		}

